{
  "name": "ngx-formidable-portal",
  "version": "0.0.0",
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test ngx-formidable",
    "lint": "eslint projects/ngx-formidable/src src",
    "style-lint": "stylelint \"projects/ngx-formidable/src/**/*.scss\" \"src/**/*.scss\"",
    "docs:check": "node scripts/check-token-descriptions.mjs",
    "docs:lint": "markdownlint-cli2",
    "screenshots": "node scripts/screenshots.mjs",
    "prettier:check": "prettier --check .",
    "prebuild:lib": "cp README.md projects/ngx-formidable/README.md && cp LICENSE projects/ngx-formidable/LICENSE",
    "build:lib": "ng build ngx-formidable",
    "publish:lib": "npm publish ./dist/ngx-formidable"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "date-fns": "^4.4.0",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.12.0",
    "marked": "^16.4.2",
    "mermaid": "^11.17.2",
    "ngx-mask": "^22.1.0",
    "pikaday": "^1.8.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "vest": "^6.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "10.0.1",
    "@types/pikaday": "^1.7.10",
    "@vitest/browser-playwright": "^5.0.3",
    "angular-eslint": "22.5.0",
    "eslint": "10.11.0",
    "eslint-plugin-rxjs-x": "1.0.6",
    "fast-check": "^4.10.2",
    "markdownlint-cli2": "0.23.3",
    "markdownlint-rule-relative-links": "3.0.0",
    "ng-packagr": "^22.2.1",
    "playwright": "^1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-organize-attributes": "1.0.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.3"
  }
