{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Grouping, ceilings and the Angular procedure are explained in .documentation/impl/renovate.md",
  "extends": ["config:recommended", "group:allNonMajor", "security:minimumReleaseAgeNpm"],
  "schedule": ["* * 1 * *"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "MCP servers that npx runs at the version pinned in .mcp.json",
      "managerFilePatterns": ["/^\\.mcp\\.json$/"],
      "matchStrings": ["\"(?<depName>(?:@[\\w.-]+/)?[\\w.-]+)@(?<currentValue>\\d[\\w.-]*)\""],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Angular majors move with ng update, whose migrations Renovate cannot run",
      "matchPackageNames": ["@angular/*", "angular-eslint", "ng-packagr", "ngx-mask", "typescript"],
      "matchUpdateTypes": ["major"],
      "groupName": "Angular",
      "dependencyDashboardApproval": true
    },
    {
      "description": "An app must run the Angular major the library was built with, so these peers move instead of widening",
      "matchDepTypes": ["peerDependencies"],
      "matchPackageNames": ["@angular/*", "ngx-mask"],
      "rangeStrategy": "replace"
    },
    {
      "matchPackageNames": ["eslint", "@eslint/js", "typescript-eslint", "eslint-plugin-rxjs-x"],
      "matchUpdateTypes": ["major"],
      "groupName": "ESLint"
    },
    {
      "matchPackageNames": ["stylelint", "stylelint-config-standard-scss"],
      "matchUpdateTypes": ["major"],
      "groupName": "Stylelint"
    },
    {
      "matchPackageNames": ["prettier", "prettier-plugin-organize-attributes"],
      "matchUpdateTypes": ["major"],
      "groupName": "Prettier"
    },
    {
      "matchPackageNames": ["vitest", "@vitest/*"],
      "matchUpdateTypes": ["major"],
      "groupName": "Vitest"
    },
    {
      "description": "Storybook majors move with storybook upgrade, whose automigrations Renovate cannot run",
      "matchPackageNames": ["storybook", "@storybook/*", "eslint-plugin-storybook"],
      "matchUpdateTypes": ["major"],
      "groupName": "Storybook",
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Ceiling: @angular/compiler-cli, ng-packagr and typescript-eslint peer typescript >=6.0 <6.1",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1"
    },
    {
      "description": "Ceiling: @angular/build peers vitest ^4.0.8 || ^5.0.0",
      "matchPackageNames": ["vitest", "@vitest/*"],
      "allowedVersions": "<6"
    }
  ]
}
